{
  "name": "uni-ui",
  "version": "0.1.0",
  "description": "面向产品的跨框架 PC Web 组件库（React 18 + Vue 3），macOS 毛玻璃设计语言，零运行时、tree-shaking。",
  "type": "module",
  "license": "MIT",
  "author": "benoly520",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "theme.css"
  ],
  "exports": {
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./vue/*": {
      "types": "./dist/vue/*.d.ts",
      "import": "./dist/vue/*.js"
    },
    "./plain": {
      "types": "./src/plain/index.ts",
      "import": "./src/plain/index.ts"
    },
    "./plain/*": "./src/plain/*",
    "./theme.css": "./theme.css",
    "./theme": "./theme.css"
  },
  "main": "./dist/react.js",
  "module": "./dist/react.js",
  "types": "./dist/react/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build && pnpm run types",
    "build:modules": "rm -rf dist && UNI_UI_MODULES=1 vite build && pnpm run types",
    "types": "vue-tsc -p tsconfig.json --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "jsdom": "^30.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.1.0"
  }
}
