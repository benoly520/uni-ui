{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "uni-ui-h5/react": ["../src/react/index.ts"],
      "uni-ui-h5/vue": ["../src/vue/index.ts"],
      "uni-ui-h5/plain": ["../src/plain/index.ts"],
      "uni-ui-h5/flexible": ["../src/flexible.ts"],
      "uni-ui-h5/theme.css": ["../theme.css"],
      "plain": ["../../../plain-framework/dist/index.d.ts"],
      "plain/vite": ["../../../plain-framework/dist/vite/index.d.ts"],
      "react": ["node_modules/react"],
      "react-dom": ["node_modules/react-dom"],
      "react/jsx-runtime": ["node_modules/react/jsx-runtime"],
      "vue": ["node_modules/vue"]
    },
    "types": ["vite/client"],
    "noImplicitAny": false
  },
  "include": ["src"]
}
